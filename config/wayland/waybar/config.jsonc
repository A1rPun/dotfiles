// My waybar config
// ~/.config/waybar/config.jsonc
{
  "layer": "top",
  "height": 32,
  "margin": "4px 4px 0",
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "mango/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],
  "mango/window": {
    "format": "{title}",
    "icon": true,
    "expand": true,
    "icon-size": 20
  },
  "ext/workspaces": {
    "all-outputs": false,
    "on-click": "activate",
    "persistent_workspaces": {
      "*": 4
    },
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": ""
    }
  },
  "clock": {
    "tooltip-format": "{:%A %B %d %Y}",
    // "format": "<span fgcolor='#777'></span> {:%d-%m-'%y, %H:%M:%S}",
    "format": "<span fgcolor='#777'></span> 2o{:%y年%m月%d日，%H点%M分%S秒}",
    "interval": 1
  },
  "cpu": {
    "interval": 4,
    "format": "<span fgcolor='#777'></span> {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 30,
    "format": "<span fgcolor='#777'></span> {percentage}%"
  },
  "network": {
    "interval": 30,
    "format-wifi": "<span fgcolor='#777'></span> {signalStrength}%",
    "format-ethernet": "<span fgcolor='#777'></span> {ifname}",
    "format-disconnected": "<span fgcolor='#777'></span>",
    "tooltip-format": "{ifname}: up: {bandwidthUpBytes}, down: {bandwidthDownBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  },
  "pulseaudio": {
    "format": "<span fgcolor='#777'>{icon}</span> {volume}%",
    "format-bluetooth": "<span fgcolor='#777'>{icon}</span> {volume}%",
    "format-muted": "<span fgcolor='#777'></span> muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol"
  },
  "battery": {
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format": "<span fgcolor='#777'>{icon}</span> {capacity}%"
  }
}