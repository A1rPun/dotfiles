// My waybar config
// ~/.config/waybar/config.jsonc

{
	"layer": "top",
	"height": 32,
	"margin": "0 0 0 0",
	"modules-left": [
		"ext/workspaces"
	],
	"modules-center": [
		"mango/window"
	],
	"modules-right": [
		"custom/cpulbl", "cpu",
		"custom/memlbl", "memory",
		"network",
		"pulseaudio",
		"battery",
		"custom/lbltime", "clock"
	],
	"mango/window": {
		"format": "{title}",
		"icon": true,
		"expand": true,
		"icon-size": 20
	},
	"ext/workspaces": {
		"all-outputs": false,
		"on-click": "activate",
		"persistent_workspaces": {"*": 4},
		"format" : "<span fgcolor='#777'>[</span>{icon}<span fgcolor='#777'>]</span>",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": ""
		}
	},
	"custom/lbltime" : { "format": "<span fgcolor='#777'></span>", "tooltip": false },
	"clock": {
		"tooltip-format": "{:%d-%m-%Y}",
		"format": "{:%d-%m-'%y %H:%M:%S}",
		"interval": 1
	},
	"custom/cpulbl" : { "format": "<span fgcolor='#777'></span>", "tooltip": false },
	"cpu": {
		"interval": 4,
		"format": "{usage}%",
		"max-length": 10
	},
	"custom/memlbl" : { "format": "<span fgcolor='#777'></span>", "tooltip": false },
	"memory": {
		"interval": 30,
		"format": "{used:0.1f}/{total:0.1f} GB"
	},
	"network": {
		"interval": 30,
		"format-wifi": "<span fgcolor='#777'></span> {signalStrength}%",
		"format-ethernet": "<span fgcolor='#777'></span> {ifname}",
		"format-disconnected": "<span fgcolor='#777'></span>",
		"tooltip-format": "{ifname}: up: {bandwidthUpBytes}, down: {bandwidthDownBytes}",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50
	},
	"pulseaudio": {
		"format": "<span fgcolor='#777'>{icon}</span> {volume}%",
		"format-bluetooth": "<span fgcolor='#777'>{icon}</span> {volume}%",
		"format-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol"
	},
	"battery": {
		"format-icons": ["", "", "", "", ""],
		"format": "<span fgcolor='#777'>{icon}</span> {capacity}%"
	}
}
